{
  "name": "coral-memory",
  "version": "0.2.0",
  "description": "脑珊瑚 Coral Memory — 面向 LLM Agent 的热度感知记忆层（DeepSeek Harness 插件）：MCP 记忆工具（memory_search/insert/thread_* 等 16 个）+ 设置面板（统计/容量/检索/配额）。作者：Mr. Code Muggle (@Ne)。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "llm",
    "embedding",
    "rag",
    "coral",
    "brain-coral"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime",
    "bridge.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test:bridge": "python -X utf8 bridge.py report",
    "prepack": "node scripts/sync-runtime.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
